{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://undrive.pages.dev",
          "http://localhost:5173",
          "http://localhost:6660"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "Content-Type"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
