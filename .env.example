# Copy to .env.local and adjust. .env.local is gitignored.

# --- API endpoint (local dev) ---
# The frontend (vite, :5173) talks to the worker (wrangler, :8787).
VITE_API_URL=http://localhost:8787

# --- Optional plugins ---
# Off by default. Set to 1 to wire in optional plugins found under
# src/lib/extensions/plugins/ (frontend) and worker/src/plugins/ (backend).
# With no plugin files present this has no effect.
ENABLE_PLUGINS=0
